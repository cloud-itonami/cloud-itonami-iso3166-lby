#:culture{:id "lby.dish.bazin", :name "Bazin", :country "LBY", :kind :dish, :summary "Unleavened bread of Libyan cuisine prepared with barley, water and salt, typically served with a tomato sauce, eggs, potatoes and mutton or camel; recognized as a traditional and national food of Libya.", :url "https://en.wikipedia.org/wiki/Bazin_(bread)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.dish.asida", :name "Asida", :country "LBY", :kind :dish, :summary "Arabic pudding made by stirring wheat flour into boiling water; the Libyan variation is served with a sweet date or carob syrup (rub) or honey, with melted butter around the asida.", :url "https://en.wikipedia.org/wiki/Asida", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.dish.couscous", :name "Couscous", :country "LBY", :kind :dish, :summary "Staple food throughout the Maghrebi cuisines of Algeria, Tunisia, Mauritania, Morocco and Libya; in Libya it is traditionally served with lamb, camel meat or beef, and as a dessert (maghrood) with dates, sesame and honey.", :url "https://en.wikipedia.org/wiki/Couscous", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.dish.usban", :name "Usban", :country "LBY", :kind :dish, :summary "Traditional North African sausage of rice, herbs, lamb, liver and heart, made in Tunisia and, to a lesser extent, Libya, typically served with rice or couscous on special occasions.", :url "https://en.wikipedia.org/wiki/Usban", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.product.rub", :name "Rub (date syrup)", :country "LBY", :kind :product, :summary "Thick, dark-brown, very sweet syrup extracted from dates or carob, widely used in Libya.", :url "https://en.wikipedia.org/wiki/Libyan_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.beverage.mint-tea", :name "Maghrebi mint tea", :country "LBY", :kind :beverage, :summary "Gunpowder green tea prepared with spearmint leaves and sugar, traditional to the Greater Maghreb including Libya, where mint tea is central to social life.", :url "https://en.wikipedia.org/wiki/Maghrebi_mint_tea", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.heritage.leptis-magna", :name "Leptis Magna", :country "LBY", :kind :heritage, :summary "Ancient Roman city in the Khoms region about 130 km east of Tripoli, Libya; the Archaeological Site of Leptis Magna was designated a UNESCO World Heritage Site in 1982.", :url "https://en.wikipedia.org/wiki/Leptis_Magna", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.heritage.cyrene", :name "Cyrene", :country "LBY", :kind :heritage, :summary "Ancient Greek colony and Roman city near present-day Shahhat in northeastern Libya, a UNESCO World Heritage Site since 1982.", :url "https://en.wikipedia.org/wiki/Cyrene,_Libya", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "lby.heritage.ghadames", :name "Old Town of Ghadames", :country "LBY", :kind :heritage, :summary "Oasis town in the Nalut District of northwestern Libya near the Algerian and Tunisian borders; its old town was inscribed as a UNESCO World Heritage Site in 1986.", :url "https://en.wikipedia.org/wiki/Ghadames", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
